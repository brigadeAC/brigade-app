{
  // Cloudflare Pages configuration for Brigade Athletic Club (forked from ApexTraining).
  // Deploy:  npm run build && npx wrangler pages deploy
  // (first time: npx wrangler login)
  "name": "brigade-app",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // D1 database binding (env.DB). Database "brigade-app" already exists in
  // the Cloudflare account; this is its id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brigade-app",
      "database_id": "2d3baffe-74e7-4ee5-b3ac-ab05a7e7ca74"
    }
  ],

  // R2 bucket for file uploads (env.FILES). Create it once with:
  //   npx wrangler r2 bucket create brigade-app-files
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "brigade-app-files"
    }
  ],

  // Workers AI binding (env.AI) — built-in Cloudflare AI, no API key required.
  // Free tier: 10,000 neurons/day. Used by InvokeLLM when LLM_API_KEY is not set.
  "ai": {
    "binding": "AI"
  },

  // Non-secret vars. Set AUTH_SECRET and LLM_API_KEY as encrypted secrets in the
  // Pages dashboard (Settings → Environment variables) — do NOT commit them here.
  "vars": {
    "LLM_MODEL": "claude-sonnet-5",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
